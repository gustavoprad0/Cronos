# Server Environment
PORT=3001
REALTIME_PORT=3002
REALTIME_HTTP_URL=http://localhost:3002
REALTIME_INTERNAL_SECRET=cronos-local-realtime
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cronos
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cronos

# pgAdmin
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@cronos.com
PGADMIN_DEFAULT_PASSWORD=admin

# Autenticação (a conta inicial de desenvolvimento é criada por docker/init.sql)
JWT_SECRET=cronos_super_secret_jwt_key_2026

